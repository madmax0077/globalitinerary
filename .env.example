# ---- Site ----
NEXT_PUBLIC_SITE_URL="https://globalitinerary.in"

# ---- Images ----
# Default: photos load from Unsplash/Wikimedia (no Vercel Image Optimization quota).
# Set this only if you want `/_next/image` again (it counts toward 100K cache writes):
# USE_VERCEL_IMAGE_OPTIMIZATION="1"

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://user:password@localhost:5432/globalitinerary?schema=public"

# ---- NextAuth / Auth.js ----
AUTH_SECRET="generate-with:  npx auth secret"
AUTH_URL="http://localhost:3000"

# GitHub OAuth (optional example provider)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---- Google AdSense ----
# Step 1 (to APPLY for approval): set your publisher ID, e.g. "ca-pub-1234567890123456".
#   This adds the verification script + account meta + ads.txt so Google can review the
#   site. It does NOT display any ads yet.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
#
# Step 2 (ONLY after your account is APPROVED): set this to "true" to start showing ad units.
#   Leave it empty/false while under review so no ads or placeholders appear.
NEXT_PUBLIC_ADSENSE_ENABLED=""

# ---- Ezoic (optional; conflicts with AdSense — leave off while using AdSense) ----
NEXT_PUBLIC_EZOIC_ENABLED=""

# ---- Bing / IndexNow (daily 100-URL submit) ----
# Bing Webmaster Tools → Settings → API Access → generate API key
BING_WEBMASTER_API_KEY=""
# Optional: require ?token=... on GET /api/indexnow (manual runs)
INDEXNOW_TOKEN=""
# Cron (Vercel or Cloudflare Workers) sends Authorization: Bearer CRON_SECRET
CRON_SECRET=""

# ---- Cloudflare Workers (OpenNext) ----
# Create the R2 bucket once: npx wrangler r2 bucket create globalitinerary-next-cache
# Then set the same secrets in: wrangler secret put NAME
# Required: CRON_SECRET, INDEXNOW_TOKEN
# Optional: BING_WEBMASTER_API_KEY, AUTH_*, DATABASE_URL

# ---- Baidu Search (中国百度) ----
# ziyuan.baidu.com → 普通收录 → API推送 token
BAIDU_PUSH_TOKEN=""
# Must match the site URL you verified in Baidu (usually https://globalitinerary.in)
BAIDU_SITE_URL="https://globalitinerary.in"
# Overseas / no ICP sites are often limited to ~10 URL pushes per day
BAIDU_DAILY_LIMIT="10"
# Optional HTML verification code from Baidu (meta name=baidu-site-verification)
NEXT_PUBLIC_BAIDU_SITE_VERIFY=""
