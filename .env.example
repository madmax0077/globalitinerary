# ---- Site ----
NEXT_PUBLIC_SITE_URL="https://globalitinerary.in"

# ---- Images ----
# Default: photos load from Unsplash/Wikimedia (no Vercel Image Optimization quota).
# Set this only if you want `/_next/image` again (it counts toward 100K cache writes):
# USE_VERCEL_IMAGE_OPTIMIZATION="1"

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://user:password@localhost:5432/globalitinerary?schema=public"

# ---- NextAuth / Auth.js ----
AUTH_SECRET="generate-with:  npx auth secret"
AUTH_URL="http://localhost:3000"

# GitHub OAuth (optional example provider)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---- Google AdSense ----
# Step 1 (to APPLY for approval): set your publisher ID, e.g. "ca-pub-1234567890123456".
#   This adds the verification script + account meta + ads.txt so Google can review the
#   site. It does NOT display any ads yet.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
#
# Step 2 (ONLY after your account is APPROVED): set this to "true" to start showing ad units.
#   Leave it empty/false while under review so no ads or placeholders appear.
NEXT_PUBLIC_ADSENSE_ENABLED=""

# ---- Ezoic (optional; conflicts with AdSense — leave off while using AdSense) ----
NEXT_PUBLIC_EZOIC_ENABLED=""
