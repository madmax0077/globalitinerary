{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.globalitinerary.in" }],
      "destination": "https://globalitinerary.in/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.globalitinerary.in" }],
      "destination": "https://globalitinerary.in/:path*",
      "permanent": true
    }
  ]
}
